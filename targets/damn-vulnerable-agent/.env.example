# Copia este archivo a .env y ajusta si lo necesitas.

# ollama (por defecto) u openai
LLM_BACKEND=ollama

OLLAMA_MODEL=llama3.2:3b

# Solo si LLM_BACKEND=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Mitigación de attacks/01-tool-poisoning. false = vulnerable (por defecto).
ENABLE_TOOL_SANITIZER=false
